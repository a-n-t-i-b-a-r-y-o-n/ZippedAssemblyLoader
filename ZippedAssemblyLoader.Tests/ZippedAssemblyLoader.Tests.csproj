<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.0"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0"/>
        <PackageReference Include="xunit" Version="2.5.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>
    
    <!-- Include test archive files -->
    <ItemGroup>
        <TestArchives Include=".\res\**" />
    </ItemGroup>
    <!-- Copy test archives to output directory -->
    <Target Name="CopyTestArchiveFiles" AfterTargets="Build">
        <Copy
            SourceFiles="@(TestArchives)"
            DestinationFolder="$(OutputPath)\%(RecursiveDir)"
            SkipUnchangedFiles="true"	/>
    </Target>

    <ItemGroup>
        <ProjectReference Include="..\ZippedAssemblyLoader\ZippedAssemblyLoader.csproj" />
    </ItemGroup>

</Project>
